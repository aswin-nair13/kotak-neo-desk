# ---- App auth (web UI login) ----
# Create hash via (from backend/): uv run python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt()).decode())"
APP_USERNAME=trader
APP_PASSWORD_BCRYPT=$2b$12$REPLACE_WITH_BCRYPT_HASH
JWT_SECRET=change-me-to-32plus-random-chars
JWT_TTL_MIN=480

# Comma-separated. Dynamic-IP friendly — mix and match:
#   single IP   49.37.123.45
#   CIDR range  49.37.0.0/16        (covers your ISP's whole pool; find yours via whatismyip + whois)
#   wildcard    49.37.*.*
#   DDNS name   myhome.ddns.net     (best for changing IP: run a DDNS updater on your PC/router,
#                                    server re-resolves it every IP_ALLOWLIST_REFRESH_SEC)
# Empty = allow all (not recommended).
# Behind Tailscale (recommended), 100.64.0.0/10 is a reasonable value.
IP_ALLOWLIST=myhome.ddns.net
IP_ALLOWLIST_REFRESH_SEC=300
# Trust X-Forwarded-For for the client IP. Keep false unless the app runs behind
# a proxy AND uvicorn is started with --proxy-headers --forwarded-allow-ips=<proxy>
# (the Docker image already passes --proxy-headers; port 8000 is internal-only).
TRUST_PROXY=false

# ---- Browser Origin policy (C1/C4) ----
# Comma-separated allowed Origins for the /ws upgrade and CORS.
# Empty = no Origin enforcement and no CORS middleware (same-origin SPA + Vite dev proxy).
# In production set your public URL(s), e.g. https://desk.tailnet.ts.net
ALLOWED_ORIGINS=

# ---- Kotak Neo API (server-side only, never shipped to browser) ----
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=
# TOTP secret is NOT stored — you type the live TOTP in the UI each morning (like TransTrader OTP step).
# Optional: CA bundle (PEM path) for the scrip-master CSV download. TLS is ALWAYS
# verified (never disabled); leave blank to use the system/certifi trust store.
# Set only if the scrip-master host fails verification and you have a pinned chain.
SCRIP_MASTER_CA_BUNDLE=

# ---- Trading defaults ----
DEFAULT_EXCHANGE_NSE_FO=nse_fo
DEFAULT_EXCHANGE_BSE_FO=bse_fo
DEFAULT_PRODUCT=MIS
NIFTY_LOT=75
SENSEX_LOT=20
POSITIONS_POLL_SEC=30

# ---- Order-feed liveness / single-writer worker (Plan 06 WP1+WP2) ----
# A quiet feed is not a dead feed: the bridge reconnects on the SDK's
# is_connected=False, and only uses FEED_IDLE_RECONNECT_SEC as a last resort
# when the SDK exposes no connection signal. FEED_STALE_SEC is warning-only.
FEED_STALE_SEC=30
FEED_WATCHDOG_SEC=5
FEED_IDLE_RECONNECT_SEC=300
RECONCILE_SEC=30
# Never ERROR a leg from one empty/lagging order-book snapshot.
SL_VISIBILITY_GRACE_SEC=10
SL_MISSING_CONFIRMATIONS=2
# Require two consecutive authoritative flat snapshots before EXTERNAL_FLAT.
FLAT_POSITION_CONFIRMATIONS=2

# ---- SL guarantee / exit integrity (Plan 06 WP3+WP4) ----
# An accepted entry must have a live protective SL within this window. If it is
# still unfilled after the window the engine logs a SL GUARANTEE MISSED alert;
# ALERT only (default) or AUTO_CANCEL the unfilled entry.
SL_GUARANTEE_SEC=12
SL_GUARANTEE_BEHAVIOR=alert
# Reconcile may re-place a missing/rejected/cancelled SL this many times before
# ERRORED + naked_position. It never places a duplicate over a live SL.
SL_REPLACE_MAX_ATTEMPTS=1
# Manual SL modify: while this window is open, reconcile never re-places the old
# stop; the feed/book echo (or deadline) settles it.
# Must exceed BROKER_CALL_TIMEOUT_SEC + 1s or startup validation fails.
SL_MODIFY_TIMEOUT_SEC=15
# Operator cancel intent is recorded before/regardless of the broker response.
SL_CANCEL_TIMEOUT_SEC=8
# Bounded retries for a stale working SL on an already-CLOSED leg.
CLOSED_SL_CANCEL_MAX_ATTEMPTS=3
# Caller timeout for UI reads on the dedicated read worker (not the mutation
# worker, so a slow read cannot delay cancel/exit).
ORDERBOOK_TIMEOUT_SEC=8
# Target exit: cancel the SL and confirm it is terminal in the order book before
# firing one market exit. If confirmation fails, the leg is ERRORED with
# EXIT_BLOCKED_SL_STILL_WORKING (use Force exit in the UI after checking).
EXIT_CONFIRM_TIMEOUT_SEC=8
EXIT_CONFIRM_POLL_SEC=0.5
EXIT_CONFIRM_RETRIES=2
# Entry auto-cancel retries start at the first attempt (not the already-expired
# guarantee deadline), so a 30s reconcile can still retry a failed cancel.
ENTRY_CANCEL_RETRY_SEC=60
ENTRY_CANCEL_MAX_ATTEMPTS=3

# Single-writer queue + HTTP broker timeout.
BROKER_WORKER_QUEUE=1000
BROKER_CALL_TIMEOUT_SEC=10
BROKER_STALL_LOG_SEC=5
WORKER_STOP_TIMEOUT_SEC=5
# Duplicate-order protection (Plan 06 WP8). On a timed-out/uncertain entry the
# engine looks the deterministic client tag up in the order report and adopts it;
# only an authoritative miss retries. This is TOTAL attempts (2 = one retry).
ORDER_PLACE_MAX_ATTEMPTS=2
# Bounded re-read window for a just-accepted order before allowing a retry.
ORDER_PLACE_CONFIRM_SEC=1.5
# Retain superseded/abandoned entry tags so a late order is adopted/alerted.
ORDER_TAG_TTL_SEC=21600
ORDER_TAG_REGISTRY_MAX=1000
# Optional prefix on every generated entry/SL/exit client tag (max 6 chars;
# action + unique ref tail + attempt still fit the broker's 20). Empty preserves
# the legacy short tags (E.../S.../X...).
ORDER_TAG_PREFIX=

# ---- Watch coalescing / placement hygiene (Plan 06 WP9+WP11) ----
# Per-session minimum spacing for watchlist subscriptions; rapid edits are
# merged into one subscribe round. Identical requests are deduped.
WATCH_MIN_INTERVAL_MS=500
# Drop a browser watch session once it has not sent a watch/heartbeat for this
# long (the UI heartbeats well inside this window). Must be > 0.
WATCH_SESSION_TTL_SEC=900
# Block a second working bracket on the same contract unless explicitly enabled.
ALLOW_STACKED_ENTRIES=false
# Warn (never reject) when a passive limit is farther than this from LTP.
MAX_PASSIVE_OFFSET=5
# Bound CLOSED trackers; open/ERRORED legs are never pruned.
CLOSED_RETENTION_SEC=86400
CLOSED_TRACKERS_MAX=500
