# ---- App auth (web UI login) ----
# Create hash via (from backend/): uv run python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt()).decode())"
APP_USERNAME=trader
APP_PASSWORD_BCRYPT=$2b$12$REPLACE_WITH_BCRYPT_HASH
JWT_SECRET=change-me-to-32plus-random-chars
JWT_TTL_MIN=480

# Comma-separated. Dynamic-IP friendly — mix and match:
#   single IP   49.37.123.45
#   CIDR range  49.37.0.0/16        (covers your ISP's whole pool; find yours via whatismyip + whois)
#   wildcard    49.37.*.*
#   DDNS name   myhome.ddns.net     (best for changing IP: run a DDNS updater on your PC/router,
#                                    server re-resolves it every IP_ALLOWLIST_REFRESH_SEC)
# Empty = allow all (not recommended).
# Behind Tailscale (recommended), 100.64.0.0/10 is a reasonable value.
IP_ALLOWLIST=myhome.ddns.net
IP_ALLOWLIST_REFRESH_SEC=300
# Trust X-Forwarded-For for the client IP. Keep false unless the app runs behind
# a proxy AND uvicorn is started with --proxy-headers --forwarded-allow-ips=<proxy>
# (the Docker image already passes --proxy-headers; port 8000 is internal-only).
TRUST_PROXY=false

# ---- Browser Origin policy (C1/C4) ----
# Comma-separated allowed Origins for the /ws upgrade and CORS.
# Empty = no Origin enforcement and no CORS middleware (same-origin SPA + Vite dev proxy).
# In production set your public URL(s), e.g. https://desk.tailnet.ts.net
ALLOWED_ORIGINS=

# ---- Kotak Neo API (server-side only, never shipped to browser) ----
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=
# TOTP secret is NOT stored — you type the live TOTP in the UI each morning (like TransTrader OTP step).
# Optional: CA bundle (PEM path) for the scrip-master CSV download. TLS is ALWAYS
# verified (never disabled); leave blank to use the system/certifi trust store.
# Set only if the scrip-master host fails verification and you have a pinned chain.
SCRIP_MASTER_CA_BUNDLE=

# ---- Trading defaults ----
DEFAULT_EXCHANGE_NSE_FO=nse_fo
DEFAULT_EXCHANGE_BSE_FO=bse_fo
DEFAULT_PRODUCT=MIS
NIFTY_LOT=75
SENSEX_LOT=20
POSITIONS_POLL_SEC=30
